# ============================================================================
# FMS 前端 Docker 构建上下文排除项
# ----------------------------------------------------------------------------
# 作用：减小发送给 Docker daemon 的构建上下文体积，加快构建并避免
# 本机 node_modules / dist / IDE 配置等噪声文件进入镜像层。
# ============================================================================

# 依赖目录（构建阶段在容器内重新安装，绝不带入宿主）
node_modules/

# 构建产物（由阶段一在容器内重新生成，带宿主 dist 只会污染缓存）
dist/

# 版本控制与 IDE 目录
.git
.idea/

# 文档与日志（README 等无需进镜像，避免镜像层携带无关文件）
*.md
*.log
