# ============================================================
# fms_backend/.dockerignore —— 后端构建上下文排除清单
# ------------------------------------------------------------
# 防泄漏与体积膨胀：上下文越小，Docker 传输数据越少、层缓存越稳；
# 尤其 config/ 含明文密码（application.yaml），必须挡在构建上下文外。
# ============================================================

target/          # Maven 构建产物，体积大且可随时重建
config/          # 明文 DB 密码 + server.port=8083，禁止进入构建上下文
.git             # 版本库元数据，与镜像构建无关
.idea/           # IDE 本地配置，进上下文纯属浪费
*.md             # 文档与说明
*.log            # 日志
*.bat            # Windows 批处理脚本（start_backend.bat 等）
