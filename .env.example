# FMS 财务管理系统环境变量模板
# 用法：cp .env.example .env 后逐项替换真实值
# 全部密钥仅来自本文件，compose 内以 ${VAR:?} 强制必填，缺失即拒绝启动
# 模板不含真实密钥，严禁提交版本库

# 核心必填

# PostgreSQL 超级用户密码，仅 db 容器 entrypoint 初始化时使用
POSTGRES_PASSWORD=<请替换为强随机密码>

# fms_app 数据库角色密码，后端连接数据库使用
# 须与 fms_db_pg/init/bootstrap_base.sql 内建密码一致，init 脚本末尾自动 ALTER ROLE 对齐
# 值含 # 时其后不能出现空格加井号，dotenv 会把 # 后内容当注释截断
FMS_DB_PASSWORD=<请替换为与初始化脚本一致的强密码>

# redis 认证密码，fms-redis requirepass 与后端 SPRING_DATA_REDIS_PASSWORD 共用
# 不少于 16 字符，建议 openssl rand -hex 16，错误密码连接即失败
FMS_REDIS_PASSWORD=<请替换为强随机密码，不少于 16 字符>

# 网关与后端共享的 hmac 对称密钥，jwt 验签与请求签名各一份
# openssl rand -hex 32 生成，64 字符十六进制，两个密钥互不相同
# 均不少于 32 字符，禁占位串与全同字符；本文件留空，复制为 .env 后必须填写，
# compose 的 :? 与网关启动期强校验双重拒绝，违者不启动
# compose 自动注入网关，无需重复填写，网关独立部署时另配 FMS_RGW_* 并保持同值
FMS_JWT_SECRET=
FMS_SIGN_SECRET=

# 演示种子（固定账号/API Key），生产默认 0；演示或验收环境显式设为 1
FMS_LOAD_DEMO=0

# 部署形态

# 流复制角色密码，仅主从或集群形态使用，单机可留空
FMS_REPL_PASSWORD=<请替换为强随机密码，仅主从或集群形态使用>

# 数据库主机地址，仅多机模式必填，填写 db 主机局域网 ip
# 单机与单机集群固定使用 compose 服务名 fms-db，不读取本变量
FMS_DB_HOST=

# redis 连接

# 后端独立运行时使用，compose 场景由 SPRING_DATA_REDIS_HOST=fms-redis 覆盖
# FMS_REDIS_HOST=127.0.0.1
# FMS_REDIS_PORT=6379

# 哨兵模式叠加 docker-compose.redis-cluster.yml 时启用，取消下面三行注释并按实际拓扑填写
# FMS_REDIS_PASSWORD 同时作为数据节点与哨兵认证密码
# SPRING_PROFILES_ACTIVE=sentinel
# FMS_REDIS_SENTINEL_MASTER=fms-redis-master
# FMS_REDIS_SENTINEL_NODES=fms-redis-sentinel-1:26379,fms-redis-sentinel-2:26379,fms-redis-sentinel-3:26379

# 加密、审计与邮件

# 列加密主密钥，生产必填
# openssl rand -hex 32 生成，64 字符十六进制，init 在种子数据加密前注入 sec.app_secrets
# 仅当现值仍为种子占位值时才覆盖，已旋转密钥不被覆盖，避免既有密文不可解密
# 空值时 init 拒绝启动；仅联调可显式 FMS_ALLOW_DEFAULT_MASTER_KEY=1 使用内建占位值
FMS_MASTER_KEY=
FMS_ALLOW_DEFAULT_MASTER_KEY=0

# smtp 配置，可选，空值表示不发送邮件
# 配置后找回密码重置邮件自动生效，未配置时走重置票据路径，票据随响应返回
# 建议 openssl rand -hex 16 生成密码，compose 自动注入后端 FMS_SMTP_*
FMS_SMTP_HOST=
FMS_SMTP_PORT=465
FMS_SMTP_USERNAME=
FMS_SMTP_PASSWORD=
# 发件人地址，留空用 no-reply@fms.local
FMS_SMTP_FROM=

# 网关内部端点 token，网关经 /internal/log-batch 投递访问日志时校验 X-FMS-Int-Token
# 默认空值表示后端内部端点禁用，fail-closed
# 网关日志 pgmq 投递开启时必填，空值会使投递静默跳过，审计落库链路静默失效
FMS_INTERNAL_TOKEN=

# 部署前核对
# 单机必填五项，POSTGRES_PASSWORD、FMS_DB_PASSWORD、FMS_JWT_SECRET、FMS_SIGN_SECRET、FMS_REDIS_PASSWORD
# FMS_JWT_SECRET 与 FMS_SIGN_SECRET 不少于 32 字符且互不相同，FMS_REDIS_PASSWORD 不少于 16 字符
# 主从或集群形态填写 FMS_REPL_PASSWORD，多机形态填写 FMS_DB_HOST
# 哨兵模式同时设置 SPRING_PROFILES_ACTIVE=sentinel、FMS_REDIS_SENTINEL_MASTER 与 FMS_REDIS_SENTINEL_NODES
# 网关日志投递开启时填写 FMS_INTERNAL_TOKEN，否则审计链路静默失效
# smtp 可选；FMS_MASTER_KEY 生产必填，须在首次初始化前配置
