# FMS 财务管理系统 —— 环境变量模板
# 用法：cp .env.example .env 后逐项替换真实值。
# 全部密钥仅来自本文件；compose 内一律 ${VAR:?提示} 强制必填，缺失即拒绝启动。
# 本文件含密钥模板，严禁提交版本库。

# PostgreSQL 超级用户密码（仅 db 容器 entrypoint 初始化时使用）
POSTGRES_PASSWORD=<请替换为强随机密码>

# fms_app 数据库角色密码（后端连接数据库使用）
# 1. 须与 fms_db_pg/init/bootstrap_base.sql 内建密码一致；init 脚本末尾自动
#    ALTER ROLE 对齐 .env 值，最终以本变量为准；
# 2. 值内含 # 时其后不得出现「空格 + 井号」——dotenv 解析器会把 # 之后内容
#    当注释截断，导致密码不完整。
FMS_DB_PASSWORD=FmsApp_2026_r7Xk#9mQ2vLpZ4sD

# Redis 认证密码（fms-redis requirepass 与后端 SPRING_DATA_REDIS_PASSWORD 共用）
# 强密码 ≥16 字符（建议 openssl rand -hex 16）；错误密码后端连接即失败（fail-fast）；
# 值内 # 规则同 FMS_DB_PASSWORD。
FMS_REDIS_PASSWORD=<请替换为强随机密码（≥16 字符）>

# 流复制角色密码——仅主从/集群形态使用，单机版可不填
FMS_REPL_PASSWORD=<请替换为强随机密码（仅在主从/集群形态使用）>

# 网关与后端共享的 HMAC 对称密钥（JWT 验签 / 请求签名）
# openssl rand -hex 32 生成（64 字符十六进制），两个密钥互不相同；
# ≥32 字符、禁占位串/全同字符，网关启动期强校验，违者直接 exit(1)。
# compose 自动以同值注入网关（FMS_RGW_JWT_SECRET / FMS_RGW_SIGN_SECRET），
# 无需重复填写；仅网关独立部署（不经本 compose）时需单独配置 RGW_* 变量
# 并保持与上方对应密钥同值。
FMS_JWT_SECRET=<请替换为 openssl rand -hex 32 的输出>
FMS_SIGN_SECRET=<请替换为 openssl rand -hex 32 的输出>

# 数据库主机地址——仅多机模式必填（db 主机的 LAN IP）；单机不生效
#（单机 URL 用 compose 服务名 fms-db）
FMS_DB_HOST=192.168.1.151

# 列加密主密钥（pgcrypto.master_key）外部注入（可选，推荐生产设置）：
# openssl rand -hex 32 生成（64 字符十六进制）；init 脚本在种子数据加密写入前注入
# sec.app_secrets，仅当现值仍为种子占位值时才覆盖（已旋转/已注入密钥不被覆盖，
# 防止既有密文不可解密）。空 = 使用 init/seed_data.sql 内建占位值（仅联调）。
FMS_MASTER_KEY=

# 邮件 SMTP 配置（可选，默认空 = 邮件不发送）——配置后找回密码重置邮件自动生效；
# 未配置时找回密码走重置票据路径（票据随响应返回），邮件是尽力而为的送达通道。
# 建议 openssl rand -hex 16 生成密码；compose 已自动注入后端 FMS_SMTP_*。
FMS_SMTP_HOST=
FMS_SMTP_PORT=465
FMS_SMTP_USERNAME=
FMS_SMTP_PASSWORD=

# 网关内部端点 token——网关经 /internal/log-batch 中转投递访问日志时校验
#（头 X-FMS-Int-Token）；默认空 = 后端内部端点禁用（fail-closed）。
# 仅网关侧开启日志 PGMQ 投递（deploy/fms_rgw.yaml log.pgmq.enabled: true）时必填；
# compose 自动注入两端（FMS_RGW_LOG_TOKEN 同源同值）。空值 = 网关静默跳过投递，
# 审计落库链路静默失效（无告警）。
FMS_INTERNAL_TOKEN=

# 校验清单（替换后逐项核对）
# 1. 单机一键部署六项必填：POSTGRES_PASSWORD / FMS_DB_PASSWORD / FMS_JWT_SECRET /
#    FMS_SIGN_SECRET / FMS_REDIS_PASSWORD / FMS_DB_HOST
# 2. FMS_JWT_SECRET 与 FMS_SIGN_SECRET：≥32 字符、互不相同、无占位串
# 3. FMS_REDIS_PASSWORD：≥16 字符
# 4. FMS_REPL_PASSWORD：仅主从/集群形态必填（单机可留空）
# 5. FMS_DB_HOST：仅多机模式必填
# 6. FMS_INTERNAL_TOKEN：网关日志投递开启时必填，否则审计链路静默失效
# 7. FMS_SMTP_*：可选；邮件功能按需配置，未配置时找回密码走票据路径
# 8. FMS_MASTER_KEY：可选（推荐生产设置）；64 字符十六进制，须在首次初始化前配置
#    （存量库已初始化后配置不生效——密钥只在种子写入前注入）
# 逐项核对完毕再部署喵
